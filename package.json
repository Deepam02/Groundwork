{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:backend": "convex dev",
    "setup:local-auth": "node scripts/setup-local-auth.mjs --local",
    "check:connections": "convex run checks:configuration",
    "format": "prettier --write src convex tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src convex tests scripts *.ts *.json index.html",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.66",
    "@convex-dev/agent": "0.7.2",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workflow": "0.4.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "ai": "7.0.99",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "convex-helpers": "0.1.124",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.58",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jose": "5.10.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
