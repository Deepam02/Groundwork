# Frontend: public backend URL only. The local Convex CLI generates .env.local.
VITE_CONVEX_URL=
# Backend settings: set on Convex, never prefix these with VITE_.
# OPENAI_API_KEY
# OPENAI_MODEL (default: gpt-4.1-mini)
# FIRECRAWL_API_KEY
# AGENTMAIL_API_KEY
# AGENTMAIL_INBOX_ID
# AGENTMAIL_WEBHOOK_SECRET
# AUTH_PRIVATE_KEY (generated locally, separate per deployment)
# AUTH_JWKS (generated locally, separate per deployment)
# GROUNDWORK_FIXTURES (local backend only: true; cloud must be false)
